---
import { getImage, Picture } from "astro:assets";
import { Maximize2 } from "@lucide/astro";
import type { SiteImage } from "../data/images";

type Props = {
  image: SiteImage;
};

const { image } = Astro.props;
const widths = [400, 640, 960, 1400, 2000];
// Match the shared shell gutters and the work page's two-column gallery.
const sizes =
  "(max-width: 360px) calc(100vw - 40px), (max-width: 600px) calc(100vw - 48px), (max-width: 900px) calc((100vw - 96px) / 2), (max-width: 1260px) calc((100vw - 112px) / 2), 574px";
const previewWidth = Math.min(image.src.width, 2000);
const preview = await getImage({
  src: image.src,
  width: previewWidth,
  format: "jpeg",
});
---

<figure class="image-frame">
  <a
    href={preview.src}
    class="image-button"
    data-astro-reload
    data-preview-open
    data-preview-src={preview.src}
    data-preview-alt={image.alt}
    aria-label={`open image preview: ${image.alt}`}
  >
    <Picture
      src={image.src}
      alt={image.alt}
      widths={widths}
      sizes={sizes}
      formats={["webp"]}
      fallbackFormat="jpeg"
      loading="lazy"
      decoding="async"
    />
    <span class="expand-cue" aria-hidden="true">
      <Maximize2 size={18} stroke-width={1.5} />
    </span>
  </a>
  <figcaption>{image.caption}</figcaption>
</figure>

<style>
  .image-frame {
    min-width: 0;
    margin: 0;
  }

  .image-frame figcaption {
    margin-top: 12px;
    color: var(--color-text-subtle);
    font-size: var(--font-size-small);
  }

  .image-button {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--image-frame-aspect-ratio, auto);
    cursor: zoom-in;
    overflow: hidden;
    background: var(--color-surface);
  }

  .image-button img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-button picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .expand-cue {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    background: rgba(23, 23, 21, 0.8);
    color: var(--color-text);
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .image-button:hover .expand-cue,
  .image-button:focus-visible .expand-cue {
    opacity: 1;
  }

  @media (hover: none) {
    .expand-cue {
      opacity: 1;
    }
  }
</style>
