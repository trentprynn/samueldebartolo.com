---
import DetailList from "../components/DetailList.astro";
import RotatingSketch from "../components/RotatingSketch.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="samuel debartolo">
  <section class="studio-intro" aria-labelledby="studio-title">
    <h1 id="studio-title" class="visually-hidden">
      samuel debartolo architecture studio
    </h1>

    <div class="studio-record">
      <DetailList label="studio details">
        <div>
          <dt>location</dt>
          <dd>tucson, arizona</dd>
        </div>
        <div>
          <dt>telephone</dt>
          <dd>
            <a href="tel:+16023270390">602.327.0390</a>
          </dd>
        </div>
        <div>
          <dt>email</dt>
          <dd>
            <a href="mailto:studio@samueldebartolo.com">
              studio@samueldebartolo.com
            </a>
          </dd>
        </div>
      </DetailList>

      <p class="studio-statement">
        a small architecture practice working through atmosphere, restraint, and
        essential human experience
      </p>
    </div>

    <aside class="sketch-panel" aria-label="study sketch">
      <RotatingSketch />
    </aside>
  </section>
</SiteLayout>

<style>
  .studio-intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    align-items: start;
    gap: var(--layout-gap);
  }

  .studio-record {
    display: grid;
    gap: var(--section-space);
    padding-top: 24px;
  }

  .studio-statement {
    max-width: 32ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-lead);
    line-height: 1.3;
    text-wrap: pretty;
  }

  .sketch-panel {
    width: 100%;
    max-width: 360px;
    justify-self: end;
  }

  @media (max-width: 900px) {
    .studio-intro {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--section-space);
    }

    .studio-record {
      padding-top: 0;
    }

    .sketch-panel {
      justify-self: center;
    }
  }
</style>
