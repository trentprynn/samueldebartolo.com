---
import PageHeading from "../components/PageHeading.astro";
import { pressLinks } from "../data/press";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="press | samuel debartolo"
  description="press, publications, and selected references for samuel debartolo's architecture work."
>
  <section class="press-page" aria-labelledby="press-title">
    <PageHeading
      id="press-title"
      title="selected references"
      label="press / publications"
    />

    <ol class="press-list">
      {pressLinks.map((link, index) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class="press-link"
          >
            <span class="press-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="press-title">{link.title}</span>
            <span class="press-meta">{link.meta}</span>
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</SiteLayout>

<style>
  .press-page {
    display: grid;
    gap: var(--section-space);
  }

  .press-list {
    display: grid;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .press-link {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) minmax(0, 0.45fr);
    align-items: center;
    gap: 24px;
    padding: 24px 0;
  }

  .press-number {
    color: var(--color-text-subtle);
    font-size: var(--font-size-small);
    font-variant-numeric: tabular-nums;
  }

  .press-title {
    font-size: var(--font-size-entry);
    line-height: 1.3;
  }

  .press-meta {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .press-link:focus-visible {
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .press-link {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 8px 16px;
    }

    .press-meta {
      grid-column: 2;
    }
  }

  @media (max-width: 600px) {
    .press-link {
      padding: 16px 0;
    }
  }
</style>
