---
import { Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import wordmark from "../assets/brand/wordmark.png";
import ImagePreview from "../components/ImagePreview.astro";
import { ExternalLink } from "@lucide/astro";
import "../global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL("/social_1200_630.jpg", Astro.site);
const socialImageAlt = "black and white architectural study sketch";
const analyticsMeasurementId = "G-RW1SEYQ6C9";
const shouldTrackAnalytics = import.meta.env.PROD;

const {
  title = "samuel debartolo",
  description = "samuel debartolo is a tucson, arizona based architect.",
  noindex = false,
} = Astro.props;

function isActive(path: string) {
  return currentPath === path;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="samuel debartolo" />
    <meta name="apple-mobile-web-app-title" content="samuel debartolo" />
    <meta name="theme-color" content="#171715" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="samuel debartolo" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <style is:inline>
      /* Keep first paint dark before the global stylesheet loads. */
      :root {
        color-scheme: dark;
        background: #171715;
      }

      html,
      body {
        background: #171715;
      }
    </style>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/logo512.jpg" type="image/jpeg" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.json" />
    {shouldTrackAnalytics && (
      <>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${analyticsMeasurementId}`}
        />
        <script define:vars={{ analyticsMeasurementId }}>
          if (!window.sdAnalyticsReady) {
            window.sdAnalyticsReady = true;
            window.dataLayer = window.dataLayer || [];
            window.gtag =
              window.gtag ||
              function gtag() {
                // Match the Google tag bootstrap shape.
                // eslint-disable-next-line prefer-rest-params
                window.dataLayer.push(arguments);
              };

            window.gtag("js", new Date());
            window.gtag("config", analyticsMeasurementId, {
              send_page_view: false,
            });

            let lastTrackedPageLocation = "";

            function trackPageView() {
              const pageLocation = window.location.href;

              if (pageLocation === lastTrackedPageLocation) {
                return;
              }

              lastTrackedPageLocation = pageLocation;

              window.gtag("event", "page_view", {
                page_title: document.title,
                page_location: pageLocation,
              });
            }

            trackPageView();
            document.addEventListener("astro:page-load", trackPageView);
          }
        </script>
      </>
    )}
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      skip to content
    </a>
    <div class="site-shell">
      <header class="site-header">
        <a
          href="/"
          class="site-mark"
          aria-label="samuel debartolo home"
          transition:persist="site-mark"
        >
          <Image
            src={wordmark}
            alt=""
            width={320}
            widths={[280, 320, 560, 640, 960]}
            sizes="(max-width: 760px) 280px, 320px"
            format="png"
            loading="eager"
          />
        </a>
        <nav class="site-nav" aria-label="primary navigation">
          <a href="/" aria-current={isActive("/") ? "page" : undefined}>
            contact
          </a>
          <a href="/work" aria-current={isActive("/work") ? "page" : undefined}>
            work
          </a>
          <a
            href="/press"
            aria-current={isActive("/press") ? "page" : undefined}
          >
            press
          </a>
          <a
            href="https://plynefurniture.com"
            target="_blank"
            rel="noreferrer"
            aria-label="shop, opens plyne furniture in a new tab"
          >
            shop
            <ExternalLink class="external-link-icon" aria-hidden="true" />
          </a>
        </nav>
      </header>

      <main id="main-content" tabindex="-1">
        <slot />
      </main>
    </div>

    <ImagePreview />

    <style>
      .site-shell {
        width: min(calc(100% - var(--site-gutter) * 2), var(--site-max-width));
        min-height: 100vh;
        margin: 0 auto;
        padding: 32px 0 var(--page-space);
      }

      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 40px;
      }

      .site-mark {
        display: block;
        flex: 0 1 320px;
        width: 320px;
        max-width: 100%;
      }

      .site-mark img {
        width: 100%;
        height: auto;
      }

      .site-nav {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: 32px;
        color: var(--color-text-muted);
        font-size: var(--font-size-small);
      }

      .site-nav a {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 44px;
      }

      .external-link-icon {
        width: 12px;
        height: 12px;
        stroke-width: 1.5;
      }

      .site-nav a[aria-current="page"] {
        color: var(--color-text);
      }

      main {
        padding-top: var(--page-space);
      }

      .skip-link {
        position: fixed;
        top: 12px;
        left: var(--site-gutter);
        z-index: 100;
        padding: 12px 16px;
        background: var(--color-text);
        color: var(--color-background);
        transform: translateY(-200%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      @media (max-width: 760px) {
        .site-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 28px;
        }

        .site-mark {
          flex-basis: auto;
          width: 280px;
        }

        .site-nav {
          width: 100%;
          max-width: 360px;
          justify-content: space-between;
          gap: 16px;
        }
      }
    </style>
  </body>
</html>
